generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Transaction {
  id          String   @id @default(cuid())
  type        String   // "INCOME" or "EXPENSE"
  amount      Float
  category    String
  date        DateTime
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StockPosition {
  id          String   @id @default(cuid())
  ticker      String   @unique
  shares      Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
